{
  "name": "tramitay-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend do TramitaY, plataforma de gestão de licitações e contratações públicas.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:create": "sequelize-cli db:create --config database/config.cjs",
    "db:drop": "sequelize-cli db:drop --config database/config.cjs",
    "db:migrate": "sequelize-cli db:migrate --config database/config.cjs --migrations-path database/migrations --seeders-path database/seeders",
    "db:migrate:undo": "sequelize-cli db:migrate:undo --config database/config.cjs --migrations-path database/migrations --seeders-path database/seeders",
    "db:migrate:undo:all": "sequelize-cli db:migrate:undo:all --config database/config.cjs --migrations-path database/migrations --seeders-path database/seeders",
    "db:seed:all": "sequelize-cli db:seed:all --config database/config.cjs --migrations-path database/migrations --seeders-path database/seeders",
    "db:seed:undo": "sequelize-cli db:seed:undo:all --config database/config.cjs --migrations-path database/migrations --seeders-path database/seeders"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.6.4",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.13.0",
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.5",
    "otplib": "^13.5.0",
    "qrcode": "^1.5.4",
    "sequelize": "^6.37.8",
    "zod": "^4.6.7"
  }
}

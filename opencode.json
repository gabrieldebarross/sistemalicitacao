{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "ask" },

    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": ".env", "effect": "deny" },
    { "action": "read", "resource": "**/.env", "effect": "deny" },
    { "action": "read", "resource": "**/.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "read", "resource": "**/.env.example", "effect": "allow" },
    { "action": "read", "resource": "*.pem", "effect": "deny" },
    { "action": "read", "resource": "*.key", "effect": "deny" },
    { "action": "read", "resource": "*.p12", "effect": "deny" },
    { "action": "read", "resource": "*.pfx", "effect": "deny" },
    { "action": "read", "resource": "*.p8", "effect": "deny" },
    { "action": "read", "resource": "*.crt", "effect": "deny" },
    { "action": "read", "resource": "*.cer", "effect": "deny" },
    { "action": "read", "resource": "*id_rsa*", "effect": "deny" },
    { "action": "read", "resource": "*id_ed25519*", "effect": "deny" },
    { "action": "read", "resource": "*credential*", "effect": "deny" },
    { "action": "read", "resource": "*secret*", "effect": "deny" },
    { "action": "read", "resource": "*.sql", "effect": "ask" },
    { "action": "read", "resource": "*.dump", "effect": "deny" },
    { "action": "read", "resource": "*.sql.gz", "effect": "deny" },
    { "action": "read", "resource": "*.bak", "effect": "deny" },

    { "action": "edit", "resource": "*.env", "effect": "deny" },
    { "action": "edit", "resource": "*.env.*", "effect": "deny" },
    { "action": "edit", "resource": ".env", "effect": "deny" },
    { "action": "edit", "resource": "**/.env", "effect": "deny" },
    { "action": "edit", "resource": "**/.env.*", "effect": "deny" },
    { "action": "edit", "resource": "*.env.example", "effect": "ask" },
    { "action": "edit", "resource": "**/.env.example", "effect": "ask" },
    { "action": "edit", "resource": "*.pem", "effect": "deny" },
    { "action": "edit", "resource": "*.key", "effect": "deny" },
    { "action": "edit", "resource": "*.p12", "effect": "deny" },
    { "action": "edit", "resource": "*.pfx", "effect": "deny" },
    { "action": "edit", "resource": "*id_rsa*", "effect": "deny" },
    { "action": "edit", "resource": "*credential*", "effect": "deny" },
    { "action": "edit", "resource": "database/migrations/*", "effect": "ask" },
    { "action": "edit", "resource": "database/seeders/*", "effect": "ask" },
    { "action": "edit", "resource": ".github/workflows/*", "effect": "ask" },
    { "action": "edit", "resource": ".github/**", "effect": "ask" },
    { "action": "edit", "resource": "docker-compose*.yml", "effect": "ask" },
    { "action": "edit", "resource": "docker-compose*.yaml", "effect": "ask" },
    { "action": "edit", "resource": "**/docker-compose*.yml", "effect": "ask" },
    { "action": "edit", "resource": "Dockerfile*", "effect": "ask" },
    { "action": "edit", "resource": "**/Dockerfile*", "effect": "ask" },
    { "action": "edit", "resource": "opencode.json", "effect": "ask" },
    { "action": "edit", "resource": "opencode.jsonc", "effect": "ask" },
    { "action": "edit", "resource": "**/opencode.json", "effect": "ask" },
    { "action": "edit", "resource": "**/opencode.jsonc", "effect": "ask" },
    { "action": "edit", "resource": ".opencode/**", "effect": "ask" },
    { "action": "edit", "resource": "AGENTS.md", "effect": "ask" },
    { "action": "edit", "resource": "pnpm-lock.yaml", "effect": "ask" },

    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git show *", "effect": "allow" },
    { "action": "shell", "resource": "git branch *", "effect": "allow" },
    { "action": "shell", "resource": "git ls-files *", "effect": "allow" },
    { "action": "shell", "resource": "git ls-remote *", "effect": "allow" },
    { "action": "shell", "resource": "node --version", "effect": "allow" },
    { "action": "shell", "resource": "pnpm --version", "effect": "allow" },
    { "action": "shell", "resource": "pnpm install *", "effect": "ask" },
    { "action": "shell", "resource": "pnpm build *", "effect": "allow" },
    { "action": "shell", "resource": "pnpm test *", "effect": "allow" },
    { "action": "shell", "resource": "pnpm lint *", "effect": "allow" },
    { "action": "shell", "resource": "pnpm dev *", "effect": "ask" },
    { "action": "shell", "resource": "pnpm sequelize-cli db:migrate *", "effect": "ask" },
    { "action": "shell", "resource": "pnpm sequelize-cli db:seed:all *", "effect": "ask" },
    { "action": "shell", "resource": "git commit *", "effect": "ask" },
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "git push", "effect": "ask" },
    { "action": "shell", "resource": "git reset *", "effect": "ask" },
    { "action": "shell", "resource": "git rebase *", "effect": "ask" },
    { "action": "shell", "resource": "git checkout *", "effect": "ask" },
    { "action": "shell", "resource": "rm *", "effect": "ask" },
    { "action": "shell", "resource": "Remove-Item *", "effect": "ask" },
    { "action": "shell", "resource": "del *", "effect": "ask" },
    { "action": "shell", "resource": "rmdir *", "effect": "ask" },
    { "action": "shell", "resource": "mysql *", "effect": "ask" },
    { "action": "shell", "resource": "mysqldump *", "effect": "ask" },
    { "action": "shell", "resource": "docker *", "effect": "ask" },
    { "action": "shell", "resource": "docker-compose *", "effect": "ask" },
    { "action": "shell", "resource": "sudo *", "effect": "deny" },
    { "action": "shell", "resource": "shutdown *", "effect": "deny" },
    { "action": "shell", "resource": "format *", "effect": "deny" }
  ]
}

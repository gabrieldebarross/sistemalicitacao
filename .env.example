# Arquivo de EXEMPLO. NÃO colocar valores reais aqui.
# Copie para .env e preencha localmente. O .env real nunca é versionado.

# Aplicação
NODE_ENV=development
PORT=3000
API_PREFIX=/api

# Banco de dados
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_DIALECT=mysql

# Autenticação (segredo deve ser longo e aleatório em cada ambiente)
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Política de senha e bloqueio de login
PASSWORD_MIN_LENGTH=12
PASSWORD_HISTORY_SIZE=5
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# MFA TOTP (obrigatório em produção; mínimo de 32 caracteres)
MFA_ENCRYPTION_KEY=
MFA_ISSUER=Sistema de Licitações

# Bootstrap do administrador (usado apenas pelo seeder; deixe vazio em produção
# se não quiser criar administrador automaticamente)
ADMIN_NOME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Usuário de exemplo (apenas seeder; opcional, deixe vazio em produção)
SEED_DEMO_NOME=
SEED_DEMO_EMAIL=
SEED_DEMO_PASSWORD=
# Nome do cargo e do papel a vincular ao usuário de exemplo (opcionais)
SEED_DEMO_CARGO=
SEED_DEMO_ROLE=

# CORS (lista separada por vírgula)
CORS_ORIGIN=http://localhost:3001

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=10

# Logs
LOG_LEVEL=info
